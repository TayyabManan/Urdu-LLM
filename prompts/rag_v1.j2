{# Minimal RAG template — long instructions confuse the FT model since it
   was trained on direct Q→A, not RAG-style "use the context" prompts.
   Keep it short and natural so the model stays in distribution. #}
{% if documents -%}
{% for doc in documents -%}
{{ doc.content }}

{% endfor %}
سوال: {{ query }}
{%- else -%}
{{ query }}
{%- endif %}
